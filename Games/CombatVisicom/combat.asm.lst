                        ; XOR -- so plane 1 has to be cleared underneath them. Miss this and a tank that happened to
                        ; be sitting where the score goes leaves its red behind as a yellow impression, because the
0C0F                    DrawDigitBoth:
0C0F  BB                        phi     rb
0C10  46                        lda     r6                      ; read byte from data
0C11  5E                        str     re                      ; write it out
0C12  9E                        ghi     re                      ; $11 -> $13
0C13  FC 02                     adi     2
0C15  BE                        phi     re
0C16  F8 00                     ldi     0
0C18  5E                        str     re                      ; clear plane 1 at the same spot
0C19  9E                        ghi     re
0C1A  FF 02                     smi     2
0C1C  BE                        phi     re
0C1D  8E                        glo     re                      ; next line down
0C1E  FC 08                     adi     8
0C20  AE                        plo     re
0C21  9B                        ghi     rb                      ; decrement rb
0C22  FF 01                     smi     1
0C24  3A 0F                     bnz     DrawDigitBoth
0C26  C0 0819                   lbr     _DDDone

                        ; On entry RE -> the screen byte being cleared. Zero it in BOTH planes.
0C29                    ClearScreenBoth:
0C29  F8 00                     ldi     0
0C2B  5E                        str     re                      ; plane 0, as before
0C2C  9E                        ghi     re                      ; $11 -> $13
0C2D  FC 02                     adi     2
0C2F  BE                        phi     re
0C30  F8 00                     ldi     0
0C32  5E                        str     re                      ; and the same offset in plane 1
0C33  9E                        ghi     re
0C34  FF 02                     smi     2
0C36  BE                        phi     re
0C37  F8 00                     ldi     0                       ; leave D as _ClearScreen left it
0C39  C0 0A3A                   lbr     _CSBack

0C3C                    TintPlane1:                             ; D = the byte just XORed into plane 0
0C3C  22                        dec     r2
0C3D  52                        str     r2                      ; keep it; D is needed for the tests
0C3E  9F                        ghi     rf
0C3F  FB 10                     xri     $10                     ; a vehicle record, or ROM?
0C41  3A 54                     bnz     _TPExit
0C43  8F                        glo     rf
0C44  FA 10                     ani     $10                     ; $1000 player 1, $1010 player 2
0C46  32 54                     bz      _TPExit
0C48  9E                        ghi     re                      ; $11 -> $13
0C49  FC 02                     adi     2
0C4B  BE                        phi     re
0C4C  02                        ldn     r2                      ; the same byte, into the second plane
0C4D  EE                        sex     re
0C4E  F3                        xor
0C4F  5E                        str     re
0C50  9E                        ghi     re                      ; and back to plane 0
0C51  FF 02                     smi     2
0C53  BE                        phi     re
0C54                    _TPExit:
0C54  12                        inc     r2                      ; drop the saved byte
0C55  EE                        sex     re                      ; XORDraw expects X = E
0C56  D4                        sep     r4                      ; return into XORDraw
0C57  30 3C                     br      TintPlane1              ; reentrant, like everything else here

0C59                            .end
