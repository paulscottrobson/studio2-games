                        				 											; R7 points to the sound counter throughout the game.
0E2D  F8 CD             		ldi 	Studio2BeepTimer							; Studio 2 Beep Counter
0E2F  A7                		plo 	r7

0E30  F8 42             		ldi 	RandomSeed
0E32  AF                		plo 	rf
0E33  EF                		sex 	rf
