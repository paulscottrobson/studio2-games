0E36  73                		stxd
0E37  F8 00             		ldi 	0											; set the current level to 0 (made 1 by new level)
0E39  73                		stxd 												
0E3A  F8 03             		ldi 	3 											; set the current lives to 3
0E3C  73                		stxd

0E3D                    NextLevel: 													; start the next level
0E3D  92                		ghi 	r2 											; point RD to the current level.
0E3E  BD                		phi 	rd
0E3F  F8 41             		ldi 	Level
0E41  AD                		plo 	rd
0E42  0D                		ldn 	rd
0E43  FC 01             		adi 	1 											; increment the current level value.
0E45  5D                		str 	rd

0E46                    SameLevel:													; restart the same level
0E46  F8 09             		ldi 	>InitialiseLevel 							; Initialise the level.
0E48  B4                		phi 	r4
0E49  F8 45             		ldi 	<InitialiseLevel
0E4B  A4                		plo 	r4
0E4C  D4                		sep 	r4

0E4D                    WaitKey0: 													; wait for key 0 to be pressed.
0E4D  F8 08             		ldi 	>ScanKeypad 								; read the keyboard
0E4F  B4                		phi 	r4
0E50  F8 C4             		ldi 	<ScanKeypad
0E52  A4                		plo 	r4
0E53  D4                		sep 	r4
0E54  FE                		shl
0E55  3B 4D             		bnf 	WaitKey0

0E57                    RestartSprites:
0E57  92                		ghi 	r2 											; reset the sprite pointer to the start.
0E58  BA                		phi 	ra
0E59  F8 60             		ldi 	<SpriteStorage
0E5B  AA                		plo 	ra

0E5C                    InnerLoop:
0E5C  F8 0A             		ldi 	>MoveSprite 								; move sprite pointed to by RA
0E5E  B4                		phi 	r4
0E5F  F8 7F             		ldi 	<MoveSprite
0E61  A4                		plo 	r4
0E62  D4                		sep 	r4

0E63  8A                		glo 	ra 											; go to next sprite
0E64  FC 10             		adi 	SpriteRecordSize
0E66  AA                		plo 	ra
0E67  FB C0             		xri 	SpriteStorageEnd 							; loop back if not reached the end.
0E69  3A 5C             		bnz 	InnerLoop

0E6B  F8 0B             		ldi 	>CheckPlayerEat 							; check what the player has eaten if anything.
0E6D  B4                		phi 	r4
0E6E  F8 A0             		ldi 	<CheckPlayerEat
0E70  A4                		plo 	r4
0E71  D4                		sep 	r4

0E72  F8 0D             		ldi 	>FixupOutstanding 							; fix up outstanding points scored.
0E74  B4                		phi 	r4
0E75  F8 2D             		ldi 	<FixupOutstanding
0E77  A4                		plo 	r4
0E78  D4                		sep 	r4


0E79  F8 41             		ldi 	Level 										; read level
0E7B  AA                		plo 	ra
0E7C  0A                		ldn 	ra
0E7D  FE                		shl  												; level x 2
0E7E  FD 0E             		sdi 	14 											; subtract from 14
0E80  32 90             		bz 		NoDelay
0E82  3B 90             		bnf 	NoDelay

0E84  AE                		plo 	re 											; use it to run the delay loop.
0E85  F8 40             Slow2:	ldi 	64
0E87  AF                		plo 	rf
0E88  2F                Slow:	dec 	rf
0E89  8F                		glo 	rf
0E8A  3A 88             		bnz 	Slow
0E8C  2E                		dec 	re
0E8D  8E                		glo 	re
0E8E  3A 85             		bnz 	Slow2
0E90                    NoDelay:

0E90  F8 4D             		ldi 	<Keyboard									; set RA to point to the keyboard state.
0E92  AA                		plo 	ra

0E93  F8 08             		ldi 	>ScanKeypad 								; read the keyboard
0E95  B4                		phi 	r4
0E96  F8 C4             		ldi 	<ScanKeypad
0E98  A4                		plo 	r4
0E99  D4                		sep 	r4
0E9A  5A                		str 	ra 											; save it in the keypad status variable

0E9B  2A                		dec 	ra 											; bump the frame counter (one before the keyboard state)
0E9C  0A                		ldn 	ra
0E9D  FC 01             		adi 	1
0E9F  5A                		str 	ra

0EA0  F8 0C             		ldi 	>FrameColour 								
0EA2  B4                		phi 	r4 											; alternate-frame beeper, inline. FrameColour does both, and then
0EA3  F8 1B             		ldi 	<FrameColour 								; sets the palette from the timer. Moved out because this page is
0EA5  A4                		plo 	r4 											; full -- the call is 7 bytes where the original block was 16.
0EA6  D4                		sep 	r4

0EA7                    ChasingZero:
0EA7  F8 53             		ldi 	BonusFrameCounter 							; point RA to Bonus Frame Counter
0EA9  AA                		plo 	ra

0EAA  0A                		ldn 	ra 											; and increment it.
0EAB  FC 01             		adi 	1
0EAD  5A                		str 	ra

0EAE  F8 44             		ldi 	EatCounter 									; if eaten everything, go to next level.
0EB0  AA                		plo 	ra
0EB1  0A                		ldn 	ra
0EB2  32 3D             		bz 		NextLevel

0EB4  F8 50             		ldi 	LostLife 									; read the 'lost life' flag.
0EB6  AA                		plo 	ra
0EB7  0A                		ldn 	ra
0EB8  32 57             		bz		RestartSprites 								; and go round again if not dead.

0EBA  F8 3C             		ldi 	60 											; long beep.
0EBC  57                		str 	r7

0EBD  F8 40             		ldi 	Lives 										; point RA to lives
0EBF  AA                		plo 	ra
0EC0  0A                		ldn 	ra 											; decrement lives
0EC1  FF 01             		smi 	1
0EC3  5A                		str 	ra
0EC4  3A 46             		bnz 	SameLevel 									; if lives left, then restart.

0EC6  F8 46             		ldi 	Score 										; point RA to score
0EC8  AA                		plo 	ra

0EC9  F8 01             		ldi 	1 											; set score digit index to 1
0ECB  AE                		plo 	re

0ECC                    ScoreWriteLoop:
0ECC  8E                		glo 	re 											; convert 3 LSBs of RE to screen address in RD
0ECD  FA 07             		ani 	7
0ECF  AD                		plo 	rd
0ED0  F8 11             		ldi 	VideoPage 									; put in video page
0ED2  BD                		phi 	rd

0ED3  4A                		lda 	ra 											; read next score digit
0ED4  FC 80             		adi 	$80 										; score table offset in BIOS
0ED6  AF                		plo 	rf
0ED7  F8 04             		ldi 	$04 										; read from $480+n (the Visicom's digit table)
0ED9  BF                		phi 	rf
0EDA  0F                		ldn 	rf 											; into D, the new offset
0EDB  AF                		plo 	rf 											; put into R4, R4 now contains 5 rows graphic data

0EDC  F8 05             		ldi 	5 											; set R5.0 to 6
0EDE  AC                		plo 	rc
0EDF                    OutputChar:
0EDF  4F                		lda 	rf 											; read character and advance
0EE0  F6                		shr 												; centre in byte
0EE1  F6                		shr
0EE2  5D                		str 	rd
0EE3  8D                		glo 	rd
0EE4  FC 08             		adi 	8
0EE6  AD                		plo 	rd
0EE7  2C                		dec 	rc 											; decrement counter
0EE8  8C                		glo 	rc
0EE9  3A DF             		bnz 	OutputChar 									; loop back if nonzero
0EEB  5D                		str 	rd
0EEC  1E                		inc 	re 											; increment score index counter
0EED  8E                		glo 	re
0EEE  FB 07             		xri 	7 											; reached seven, end of score write.
0EF0  3A CC             		bnz 	ScoreWriteLoop

0EF2  30 F2             Dead:	br 		Dead

0C00                    		.org 	$C00 										; a spare cartridge page: $800-$BFF and $D00-$EFF are both full

0C00                    ColourInit:
0C00  F8 13             		ldi 	ColourPage 									; plane 1 is RAM, and the BIOS has been displaying out of it, so
0C02  BD                		phi 	rd 											; it starts full of whatever the menu left behind.
0C03  F8 00             		ldi 	0
0C05  AD                		plo 	rd
0C06                    CI_Loop:
0C06  F8 00             		ldi 	0
0C08  5D                		str 	rd
0C09  1D                		inc 	rd
0C0A  8D                		glo 	rd
0C0B  3A 06             		bnz 	CI_Loop
0C0D  F8 0C             		ldi 	>CI_Start
0C0F  B4                		phi 	r4
0C10  F8 14             		ldi 	<CI_Start
0C12  A4                		plo 	r4
0C13  D4                		sep 	r4
0C14                    CI_Start:
0C14  F8 0E             		ldi 	>StartGame
0C16  B3                		phi 	r3
0C17  F8 25             		ldi 	<StartGame
0C19  A3                		plo 	r3
0C1A  D3                		sep 	r3

                        ; ---------------------------------------------------------------------------------------------------------------------------------------
                        ;	FrameColour - called once per frame from the main loop.
                        ;
                        ;	All that is left of it on the Visicom is the work it always also did: decrement the chasing timer and beep on alternate frames.
                        ;	The colour it used to set is now decided by which plane each sprite is drawn into, so there is nothing to repaint.
                        ; ---------------------------------------------------------------------------------------------------------------------------------------

0C1B                    FrameColour:
0C1B  F8 52             		ldi 	ChasingTimer 								; RA -> chasing timer (RA.1 is already the RAM page)
0C1D  AA                		plo 	ra
0C1E  0A                		ldn 	ra
0C1F  32 2B             		bz 		FC_Done 									; not chasing -- nothing to do at all
0C21  FF 01             		smi 	1 											; decrement it
0C23  5A                		str 	ra
0C24  FA 08             		ani 	8 											; beeper on alternate frames, as before
0C26  32 2B             		bz 		FC_Done
0C28  F8 0B             		ldi 	11
0C2A  57                		str 	r7
0C2B                    FC_Done:
0C2B  D3                		sep 	r3

                        ; ***************************************************************************************************************************************
                        ;
                        ;											Sprite plotting, once per bit plane
                        ;
                        ;	SpritePlot does everything that does not depend on the plane and branches here with
                        ;
                        ;		D 		the screen offset of the sprite's top left byte
                        ;		TOS 	the low byte of the graphic address
                        ;		RB.1 	the entry point of the shift/XOR drawer for this X alignment
                        ;
                        ;	This looks the plane mask up from the graphic and runs the four-row draw once for each plane the mask asks for: $1100 first,
                        ;	then $1300. Two passes for a red sprite, one for anything else.
                        ;
                        ;	Breaks R6 -- which neither the game nor the BIOS interrupt routine uses -- as well as RC, RE and RF. RD and D survive, which
                        ;	is what the callers expect.
                        ;
                        ; ***************************************************************************************************************************************

0F32                    		.org 	$F00+<SPRP_PlaneEntry
0F32  30 39             		br 		SPRP_Planes

0F35                    		.org 	$F00+<SPRP_Reenter-4
0F35                    SPRP_Return:
0F35  AF                		plo 	rf                              ; preserve the next graphic across the page switch
0F36  F8 09             		ldi 	>SPRP_Reenter
0F38  B5                		phi 	r5                              ; resumes at SPRP_Reenter on the $900 page

0F39                    SPRP_Planes:
                        															; RF.0 already holds the screen offset.
0F39  92                		ghi 	r2 											; The screen offset has to survive from one plane pass to the
0F3A  BE                		phi 	re 											; next, and it CANNOT live on the stack: the BIOS interrupt
0F3B  F8 56             		ldi 	PlaneBase 									; routine saves three bytes *below* R2 (SAV, STXD, STR R2), so
0F3D  AE                		plo 	re 											; anything parked under the stack pointer while the row loop
0F3E  8F                		glo 	rf 											; runs gets overwritten by the saved (X,P), D and DF roughly
0F3F  5E                		str 	re
                        															; once a frame. It is stored in RAM instead, and R2 never moves
                        															; from the graphic byte SpritePlot pushed -- which is exactly
                        															; the invariant the original single-plane loop relied on.

0F40  02                		ldn 	r2 											; look the plane mask up from the graphic: graphics are four
0F41  FF 40             		smi 	<Graphics 									; bytes each from Graphics, so (graphic-Graphics)/4 is the slot
0F43  F6                		shr
0F44  F6                		shr
0F45  FC C0             		adi 	<PlaneTable
0F47  AE                		plo 	re
0F48  F8 0F             		ldi 	>PlaneTable
0F4A  BE                		phi 	re
0F4B  0E                		ldn 	re
0F4C  A6                		plo 	r6 											; R6.0 = plane mask: bit 0 is $1100, bit 1 is $1300
0F4D  F8 11             		ldi 	VideoPage
0F4F  B6                		phi 	r6 											; R6.1 = the page this pass draws into

0F50                    SPRP_PlaneLoop:
0F50  86                		glo 	r6 											; is this plane wanted?
0F51  F6                		shr
0F52  A6                		plo 	r6 											; keep what is left of the mask
0F53  3B 7A             		bnf 	SPRP_NextPlane

0F55  92                		ghi 	r2 											; RF -> the sprite's top left byte in this plane
0F56  BE                		phi 	re
0F57  F8 56             		ldi 	PlaneBase
0F59  AE                		plo 	re
0F5A  0E                		ldn 	re
0F5B  AF                		plo 	rf
0F5C  96                		ghi 	r6
0F5D  BF                		phi 	rf

0F5E                    SPRP_Loop:
0F5E  9B                		ghi 	rb 											; put the routine address in RC. RB.1 was its LSB
0F5F  AC                		plo 	rc
0F60  F8 08             		ldi 	>ShiftXORDrawerBase							; its MSB is a constant.
0F62  BC                		phi 	rc

0F63  02                		ldn 	r2 											; read the graphic address into RE.
0F64  AE                		plo 	re
0F65  F8 08             		ldi 	>Graphics
0F67  BE                		phi 	re
0F68  0E                		ldn 	re 											; read the graphic byte from RE

0F69  DC                		sep 	rc 											; call the XOR plotter.

0F6A  8F                		glo 	rf 											; move RF to next line down
0F6B  FC 08             		adi 	8
0F6D  AF                		plo 	rf

0F6E  02                		ldn 	r2 											; point to next graphics line.
0F6F  FC 01             		adi 	1
0F71  52                		str 	r2
0F72  FA 03             		ani 	3 											; graphics are aligned on address 4, so when this is zero we have drawn it.
0F74  3A 5E             		bnz		SPRP_Loop

0F76  02                		ldn 	r2 											; rewind the graphic ready for the next plane
0F77  FF 04             		smi 	4
0F79  52                		str 	r2

0F7A                    SPRP_NextPlane:
0F7A  96                		ghi 	r6 											; $11 -> $13
0F7B  FC 02             		adi 	2
0F7D  B6                		phi 	r6
0F7E  86                		glo 	r6 											; anything left in the mask?
0F7F  3A 50             		bnz 	SPRP_PlaneLoop

0F81  02                		ldn 	r2 											; D = the graphic
0F82  12                		inc 	r2 											; drop it
0F83  D4                		sep 	r4 											; and return.
0F84  30 35             		br 		SPRP_Return                     ; reentrant call without a three-cycle instruction

                        ;	Which planes each graphic is drawn into, indexed by slot. Keep this in step with the Graphics table.

0FC0                    		.org 	$FC0
0FC0                    PlaneTable:
0FC0  01                		.db 	1 											; Pellet         cyan
0FC1  02                		.db 	2 											; PowerPill      yellow-green
0FC2  02                		.db 	2 											; PacmanClosed   yellow-green
0FC3  02                		.db 	2 											; PacmanUp
0FC4  02                		.db 	2 											; PacmanDown
0FC5  02                		.db 	2 											; PacmanLeft
0FC6  02                		.db 	2 											; PacmanRight
0FC7  03                		.db 	3 											; Ghost1         red
0FC8  03                		.db 	3 											; Ghost2         red
0FC9  01                		.db 	1 											; GhostReverse   cyan -- edible, and the colour change is the cue
0FCA  02                		.db 	2 											; Cherry         yellow-green
0FCB  01                		.db 	1 											; Blank          (draws nothing whichever plane it goes to)
0FCC  01                		.db 	1 											; the spare slot after Blank

00FF                    		.org 	$FF
00FF  00                		.db 	0

