0E25                    StartGame:
0E25  F8 FF             		ldi 	$0FF 										; initialise the Stack to $2FF
0E27  A2                		plo		r2 											; from $2CF.
0E28  F8 10             		ldi 	RAMPage
0E2A  B2                		phi 	r2
0E2B  B7                		phi 	r7
