0AED  F7                        sm                              ; calculate collision-centre
0AEE  12                        inc     r2                      ; fix the stack
0AEF  32 F8                     bz      _SetYI                  ; work out the angle to go at
0AF1  FE                        shl
0AF2  F8 FF                     ldi     $FF
0AF4  33 F8                     bdf     _SetYI
0AF6  F8 01                     ldi     $01
0AF8  BB                _SetYI: phi     rb
0AF9  F8 13                     ldi     <(BallYI)
0AFB  AF                        plo     rf
0AFC  9B                        ghi     rb
0AFD  5F                        str     rf
0AFE  30 9A                     br     _WallBounce

0BFF                            .org    0BFFh                   ; fill it
0BFF  FF                        .db     0FFh

0B00                            .org    $B00

