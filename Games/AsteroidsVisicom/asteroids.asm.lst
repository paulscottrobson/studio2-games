0CED  0A                		ldn 	ra 											; increment and save digit
0CEE  FC 01             		adi 	1
0CF0  5A                		str 	ra
0CF1  FF 0A             		smi 	10 											; if < 10 then see if any more accrued points
0CF3  3B E1             		bnf 	ML_AddPoints
0CF5  5A                		str 	ra 											; save result back (e.g. mod 10)
