0C28  AE                		plo 	re

0C29  0E                		ldn 	re 											; read rotation
0C2A  AD                		plo 	rd 											; put in RD
0C2B  02                		ldn 	r2 											; read keypad
0C2C  F6                		shr
0C2D  F6                		shr  												; shift bit 1 into DF
0C2E  3B 31             		bnf 	ML_NotLeft
0C30  2D                		dec 	rd 											; if set rotate left
