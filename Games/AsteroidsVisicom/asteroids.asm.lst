0C1B  B4                		phi 	r4
0C1C  F8 33             		ldi 	<DrawPlayerSprite
0C1E  A4                		plo 	r4
0C1F  D4                		sep 	r4

0C20  92                		ghi 	r2 											; RA points to player, RE to rotation
0C21  BA                		phi 	ra
0C22  BE                		phi 	re
0C23  F8 90             		ldi 	XPlayer
0C25  AA                		plo 	ra
