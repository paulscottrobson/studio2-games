0D12  8A                		glo 	ra 											; go to next record.
0D13  FC 08             		adi 	AsteroidRecSize
0D15  AA                		plo 	ra
0D16  FB 80             		xri 	AsteroidEnd 								; check all asteroids
0D18  3A 0E             		bnz 	ML_CheckCompleted

0D1A  F8 E3             		ldi 	Level 										; completed level - bump to next.
0D1C  AA                		plo 	ra
0D1D  0A                		ldn 	ra
0D1E  FC 01             		adi 	1
0D20  5A                		str 	ra

0D21  F8 0A             		ldi 	>StartNewLevel 								; start a new level.
0D23  BC                		phi 	rc
0D24  F8 22             		ldi 	<StartNewLevel
0D26  AC                		plo 	rc
0D27  30 2F             		br 		LongBranchToRC

                        ; ---------------------------------------------------------------------------------------------------------------------------------------		
                        ; 											Loop around because we have no LBR
                        ; ---------------------------------------------------------------------------------------------------------------------------------------		

0D29                    LongBranchMainLoop:
0D29  F8 0A             Loop2:	ldi 	>MainLoop
0D2B  BC                		phi 	rc
0D2C  F8 6E             		ldi 	<MainLoop
0D2E  AC                		plo 	rc

0D2F                    LongBranchToRC:
0D2F  F8 0D             		ldi 	>JumpToRC 										; so we're stuck with this.
0D31  B4                		phi 	r4
0D32  F8 36             		ldi 	<JumpToRC
0D34  A4                		plo 	r4
0D35  D4                		sep 	r4

0D36                    JumpToRC: 														; here with P = 4
0D36  9C                		ghi 	rc 												; copy RC to R3
0D37  B3                		phi 	r3
0D38  8C                		glo 	rc
0D39  A3                		plo 	r3
0D3A  D3                		sep 	r3 												; jump to r3

                        ; ---------------------------------------------------------------------------------------------------------------------------------------		
                        ;															Life Lost
                        ; ---------------------------------------------------------------------------------------------------------------------------------------		

0D3B  92                Dead:	ghi 	r2 												; point RF to Lives
0D3C  BF                		phi		rf
0D3D  F8 E2             		ldi 	Lives
0D3F  AF                		plo 	rf
0D40  0F                		ldn 	rf 												; decrement lives count
0D41  FF 01             		smi 	1
0D43  5F                		str 	rf

0D44  32 5D             		bz 		GameOver

0D46  F8 00             		ldi 	AsteroidBase 									; set all the new flags in the asteroids as Restart will clear screen.
0D48  AF                		plo 	rf
0D49                    DeadSetNew:
0D49  0F                		ldn 	rf
0D4A  F9 40             		ori 	$40
0D4C  5F                		str 	rf
0D4D  8F                		glo		rf
0D4E  FC 08             		adi 	AsteroidRecSize
0D50  AF                		plo 	rf
0D51  FB 80             		xri 	AsteroidEnd
0D53  3A 49             		bnz		DeadSetNew

0D55  F8 0A             		ldi 	>RestartCurrentLevel 							; restart the current level
0D57  BC                		phi 	rc
0D58  F8 29             		ldi 	<RestartCurrentLevel
0D5A  AC                		plo 	rc
0D5B  30 2F             		br 		LongBranchToRC

                        ; ---------------------------------------------------------------------------------------------------------------------------------------		
                        ;															Game Over
                        ; ---------------------------------------------------------------------------------------------------------------------------------------		

0D5D                    GameOver:
0D5D  92                		ghi 	r2 										; point RD to the score.
0D5E  BD                		phi 	rd
0D5F  F8 E5             		ldi 	Score
0D61  AD                		plo 	rd
0D62  F8 06             		ldi 	6 										; make 3 LSBs of E 110 (screen position)
0D64  AE                		plo 	re
0D65  F8 0D             		ldi 	>WriteDisplayByte 						; point RA to the byte-writer
0D67  BA                		phi 	ra
0D68  F8 9C             		ldi 	<WriteDisplayByte
0D6A  AA                		plo 	ra

0D6B                    ScoreWriteLoop:
0D6B  8E                		glo 	re 										; convert 3 LSBs of RE to screen address
0D6C  FA 07             		ani 	7
0D6E  FC 58             		adi 	128-40
0D70  AE                		plo 	re
0D71  F8 11             		ldi 	VideoPage 								; put in video page
0D73  BE                		phi 	re

0D74  F8 FF             		ldi 	$FF
0D76  DA                		sep 	ra
0D77  F8 00             		ldi		$00
0D79  DA                		sep 	ra

0D7A  4D                		lda 	rd 										; read next score digit
0D7B  FC 10             		adi 	$10 									; score table offset in BIOS
0D7D  A4                		plo 	r4
0D7E  F8 02             		ldi 	$02 									; read from $210+n
0D80  B4                		phi 	r4
0D81  04                		ldn 	r4 										; into D, the new offset
0D82  A4                		plo 	r4 										; put into R4, R4 now contains 5 rows graphic data

0D83  F8 05             		ldi 	5 										; set R5.0 to 6
0D85  A5                		plo 	r5
0D86                    OutputChar:
0D86  44                		lda 	r4 										; read character and advance
0D87  F6                		shr 											; centre in byte
0D88  F6                		shr
0D89  DA                		sep 	ra 										; output it
0D8A  25                		dec 	r5 										; decrement counter
0D8B  85                		glo 	r5
0D8C  3A 86             		bnz 	OutputChar 								; loop back if nonzero

0D8E  F8 00             		ldi		$00
0D90  DA                		sep 	ra
0D91  F8 FF             		ldi 	$FF
0D93  DA                		sep 	ra

0D94  2E                		dec 	re 										; previous value of 3 LSBs.
0D95  8E                		glo 	re
0D96  FA 07             		ani 	7
0D98  3A 6B             		bnz 	ScoreWriteLoop

0D9A  30 9A             Halt:	br 		Halt

                        ; ***************************************************************************************************************************************
                        ;
                        ;											Write byte D to RE. Add 8 to RE
                        ;
                        ; ***************************************************************************************************************************************

0D9C                    WriteDisplayByte:
0D9C  5E                		str 	re 											; save result
0D9D  8E                		glo 	re 											; down one row
0D9E  FC 08             		adi 	8
0DA0  AE                		plo 	re
0DA1  D3                		sep 	r3
0DA2  30 9C             		br 		WriteDisplayByte

                        ; ***************************************************************************************************************************************
                        ;
                        ;													Asteroid Ship Graphics
                        ;
                        ; ***************************************************************************************************************************************

0DE0                    		.org 	SecondROMBase+$1E0
0DE0                    AsteroidGraphics:
0DE0  40A0A000          		.db 	64,160,160,0
0DE4  60A04000          		.db 	96,160,64,0
0DE8  C020C000          		.db 	192,32,192,0
0DEC  40A06000          		.db 	64,160,96,0
0DF0  A0A04000          		.db 	160,160,64,0
0DF4  40A0C000          		.db 	64,160,192,0
0DF8  60806000          		.db 	96,128,96,0
0DFC  C0A04000          		.db 	192,160,64,0

0E00  00                		.db 	0

                        ; ***************************************************************************************************************************************
                        ;
                        ;										Toshiba Visicom COM-100 -- clear both bit planes
                        ;
                        ;	The Visicom's picture is two planes, $1100 and $1300, and the rocks live in the second one. Clearing only the first would leave
                        ;	the previous level's rocks on the board in yellow-green with nothing underneath them.
                        ;
                        ;	RA is left at $1200 on exit, exactly where the original single-plane loop left it, because RA.0 wrapping carries into RA.1 and
                        ;	the code below RCL_Clear was written around that.
                        ;
                        ; ***************************************************************************************************************************************

0E00                    		.org 	$E00

0E00                    ClearBothPlanes:
0E00  F8 13             		ldi 	ColourPage 									; plane 1 first...
0E02  BA                		phi 	ra
0E03  F8 00             		ldi 	0
0E05  AA                		plo 	ra
0E06                    CBP_Plane1:
0E06  F8 00             		ldi 	$00
0E08  5A                		str 	ra
0E09  1A                		inc 	ra
0E0A  8A                		glo 	ra
0E0B  3A 06             		bnz 	CBP_Plane1
0E0D  F8 11             		ldi 	VideoPage 									; ...then plane 0, so RA ends at $1200 as before
0E0F  BA                		phi 	ra
0E10  F8 00             		ldi 	0
0E12  AA                		plo 	ra
0E13                    CBP_Plane0:
0E13  F8 00             		ldi 	$00
0E15  5A                		str 	ra
0E16  1A                		inc 	ra
0E17  8A                		glo 	ra
0E18  3A 13             		bnz 	CBP_Plane0
0E1A  C0 0A3A           		lbr 	RCL_ClearDone

